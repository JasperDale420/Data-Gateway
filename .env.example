# App Configuration
GATEWAY_DEBUG=true
GATEWAY_LOG_LEVEL=DEBUG

# Server
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080

# Authentication
GATEWAY_AUTH_TIMEOUT_SECONDS=10

# Cache
GATEWAY_CACHE_MAX_SIZE=10000
GATEWAY_CACHE_DEFAULT_TTL=300

# Memory Limits (PRD 6.2)
GATEWAY_MEMORY_TARGET_MB=512
GATEWAY_MEMORY_HARD_LIMIT_MB=1024

# WebSocket Limits (PRD 6.3)
GATEWAY_WS_IDLE_TIMEOUT=300
GATEWAY_WS_MAX_DURATION=86400
GATEWAY_WS_MAX_CLIENTS=100

# Shutdown Settings (PRD 11.3.4)
GATEWAY_SHUTDOWN_DRAIN_SECONDS=30

# Rate Limiting (PRD 7.5)
# Global: 10,000/min, Per-IP: 1,000/min, Per-Client: 600/min

# Stream Settings
GATEWAY_STREAM_USE_IEX=false
GATEWAY_STREAM_RECONNECT_BASE=1.0
GATEWAY_STREAM_RECONNECT_MAX=16.0

# Redis Connection (Optional - for distributed cache)
# REDIS_URL=redis://localhost:6379/0

# ====================
# Provider API Keys
# ====================

# Alpaca Markets (Required for market data + trading)
APCA_API_KEY_ID=""
APCA_API_SECRET_KEY=""
APCA_API_BASE_URL="https://paper-api.alpaca.markets"

# Unusual Whales (Required for flow/darkpool/institutional data)
UNUSUAL_WHALES_API_KEY=""

# Finnhub (Required for fundamentals/earnings/news)
FINNHUB_API_KEY=""

# Alpha Vantage (Required for technical indicators/forex/economy)
ALPHAVANTAGE_API_KEY=""

# Coinbase (Optional - for crypto)
COINBASE_API_KEY=""
COINBASE_API_SECRET=""

# News API / EventRegistry (Optional)
NEWS_API_KEY=""

# ====================
# Free Providers (No API Key Required)
# ====================
# - SEC EDGAR: Filings, 13F, insider trades at /api/v1/sec/*
# - yfinance: Fundamentals, history, options at /api/v1/yf/*

# ====================
# Data Sink (for Heber integration)
# ====================
# Enable to publish all data to Redis Streams for downstream storage
GATEWAY_DATA_SINK_ENABLED=false
GATEWAY_DATA_SINK_REDIS_URL=redis://localhost:6379/1
# GATEWAY_DATA_SINK_MAX_STREAM_LEN=100000
