# ====================
# App Configuration
# ====================
GATEWAY_DEBUG=true
GATEWAY_LOG_LEVEL=DEBUG
GATEWAY_ALLOW_STUB_DATA=false

# Server
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080

# Authentication
GATEWAY_AUTH_TIMEOUT_SECONDS=10

# ====================
# Cache
# ====================
GATEWAY_CACHE_MAX_SIZE=10000
GATEWAY_CACHE_DEFAULT_TTL=300
GATEWAY_CACHE_MAX_BODY_BYTES=524288

# Redis-backed distributed cache (optional)
# GATEWAY_CACHE_REDIS_ENABLED=false
# GATEWAY_CACHE_REDIS_URL=redis://localhost:6379/0

# ====================
# Memory Limits (PRD 6.2)
# ====================
GATEWAY_MEMORY_TARGET_MB=512
GATEWAY_MEMORY_HARD_LIMIT_MB=1024
# GATEWAY_GC_THRESHOLD_PCT=80

# ====================
# WebSocket Limits (PRD 6.3)
# ====================
GATEWAY_WS_IDLE_TIMEOUT=300
GATEWAY_WS_MAX_DURATION=86400
GATEWAY_WS_MAX_CLIENTS=100
# GATEWAY_WS_HEARTBEAT_INTERVAL=30
# GATEWAY_WS_MAX_MESSAGE_SIZE=65536

# ====================
# Shutdown Settings (PRD 11.3.4)
# ====================
GATEWAY_SHUTDOWN_DRAIN_SECONDS=30

# ====================
# Rate Limiting (PRD 7.5)
# ====================
# Global: 10,000/min, Per-IP: 1,000/min, Per-Client: 600/min
# GATEWAY_RATE_LIMIT_ENABLED=true
# GATEWAY_RATE_LIMIT_DEFAULT=600

# ====================
# Stream Settings
# ====================
GATEWAY_STREAM_USE_IEX=false
# GATEWAY_STREAM_LAZY_CONNECT=true
# GATEWAY_STREAM_RECONNECT_MAX_RETRIES=10
GATEWAY_STREAM_RECONNECT_BASE_DELAY=1.0
GATEWAY_STREAM_RECONNECT_MAX_DELAY=16.0
# GATEWAY_STREAM_FANOUT_MAX_INFLIGHT=100
# GATEWAY_STREAM_FANOUT_BATCH_SIZE=32

# ====================
# Provider API Keys
# ====================

# Alpaca Markets (Required for market data + trading)
APCA_API_KEY_ID=""
APCA_API_SECRET_KEY=""
APCA_API_BASE_URL="https://paper-api.alpaca.markets"

# Unusual Whales (Required for flow/darkpool/institutional data)
UNUSUAL_WHALES_API_KEY=""

# Finnhub (Required for fundamentals/earnings/news)
FINNHUB_API_KEY=""

# Alpha Vantage (Required for technical indicators/forex/economy)
ALPHAVANTAGE_API_KEY=""

# Coinbase (Optional - for crypto)
COINBASE_API_KEY=""
COINBASE_API_SECRET=""

# News API / NewsAPI.org (Optional)
NEWS_API_KEY=""

# SEC EDGAR (Optional but recommended)
SEC_USER_AGENT="Your Name contact@domain.com"

# ====================
# Free Providers (No API Key Required)
# ====================
# - SEC EDGAR: Filings, 13F, insider trades at /api/v1/sec/*
# - yfinance: Fundamentals, history, options at /api/v1/yf/*

# ====================
# UW Poller (automatic polling for flow/darkpool data)
# ====================
# GATEWAY_UW_POLLER_PUBLISH_MAX_INFLIGHT=16

# ====================
# UW EOD Polling (daily after-hours per-ticker snapshots)
# ====================
# Polls 9 UW endpoints per ticker after market close:
# greek_exposure, iv_rank, oi_change, historic_option_volume,
# short_interest, short_volume, ftds, congress_trades, insider_trades
GATEWAY_UW_EOD_ENABLED=false
GATEWAY_UW_EOD_HOUR=16
GATEWAY_UW_EOD_MINUTE=30
# Comma-separated override for core tickers (empty = use defaults ~30 mega-caps)
# GATEWAY_UW_CORE_TICKERS=""
GATEWAY_UW_DYNAMIC_TICKER_COUNT=20
GATEWAY_UW_EOD_CONCURRENCY=5

# ====================
# Rate Limiting & Concurrency
# ====================
GATEWAY_BULK_RATE_LIMIT_PER_HOUR=10
GATEWAY_REPLAY_MAX_CONCURRENT_SESSIONS=5


# ====================
# Data Sink (for Heber integration)
# ====================
# Enable to publish all data to Redis Streams for downstream storage
GATEWAY_DATA_SINK_ENABLED=false
GATEWAY_DATA_SINK_REDIS_URL=redis://localhost:6379/1
# GATEWAY_DATA_SINK_MAX_STREAM_LEN=100000
# Sink dispatch tuning (bounded queue + worker pool, replaces the prior
# in-flight / pending caps that drop-on-saturation):
# GATEWAY_DATA_SINK_QUEUE_SIZE=4096
# GATEWAY_DATA_SINK_WORKER_COUNT=8
# GATEWAY_DATA_SINK_PRODUCER_BLOCK_TIMEOUT_SECONDS=0.1

# ====================
# Bulk Jobs & Replay
# ====================
# GATEWAY_BULK_RESULTS_MAX_IN_MEMORY=25000
# GATEWAY_BULK_RESULTS_SPOOL_TO_DISK=true
# GATEWAY_REPLAY_MESSAGES_MAX_IN_MEMORY=50000
# GATEWAY_REPLAY_MESSAGES_SPOOL_TO_DISK=true
