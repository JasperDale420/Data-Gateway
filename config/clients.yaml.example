# Client API keys for gateway authentication
# Copy this file to clients.yaml and replace placeholder keys with real values
# Keys are stored as plaintext for development; use hashed keys in production
# Optional: role can be set to "trader", "admin", or "super_admin" for restricted endpoints

clients:
  # Cerberus trading system
  - id: cerberus
    key: CHANGE_ME_cerberus_key
    permissions:
      providers: ["alpaca", "uw", "yfinance"]
      feeds: ["bars", "quotes", "trades", "flow"]
      max_symbols: 1000
      rate_limit: 600  # requests per minute
    enabled: true

  # 3Roses daytrading system
  - id: 3roses
    key: CHANGE_ME_3roses_key
    permissions:
      providers: ["alpaca"]
      feeds: ["bars", "quotes", "trades", "news"]
      max_symbols: 100
      rate_limit: 300
    enabled: true

  # Orion trading system
  - id: orion
    key: CHANGE_ME_orion_key
    permissions:
      providers: ["alpaca", "uw", "yfinance", "finnhub"]
      feeds: ["bars", "quotes", "trades", "flow", "news", "options"]
      max_symbols: 1000
      rate_limit: 600
    enabled: true

  # Development/testing client
  - id: test
    key: CHANGE_ME_test_key
    permissions:
      providers: ["alpaca"]
      feeds: ["bars", "quotes"]
      max_symbols: 100
      rate_limit: 60
    enabled: true
