# Unusual Whales (Required)
UNUSUAL_WHALES_API_KEY=""

# Coinbase (Optional)
COINBASE_API_KEY=""
COINBASE_API_SECRET=""

# News API / EventRegistry (Optional)
NEWS_API_KEY=""

# Alpha Vantage (Optional - stub)
ALPHAVANTAGE_API_KEY=""

# Finnhub (Optional - stub)
FINNHUB_API_KEY=""

# SEC EDGAR (Free - no API key required)
# Filings, 13F, insider trades available at /api/v1/sec/*
