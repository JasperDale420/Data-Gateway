# App Configuration
GATEWAY_DEBUG=true
GATEWAY_LOG_LEVEL=DEBUG

# Server
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080

# Authentication
GATEWAY_AUTH_TIMEOUT_SECONDS=10

# Cache
GATEWAY_CACHE_MAX_SIZE=10000
GATEWAY_CACHE_DEFAULT_TTL=300

# Redis Connection (Phase 4)
# REDIS_URL=redis://localhost:6379/0

# Alpaca Markets (Required)
APCA_API_KEY_ID=""
APCA_API_SECRET_KEY=""
